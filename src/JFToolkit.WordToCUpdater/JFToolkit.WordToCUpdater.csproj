<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JFToolkit.WordToCUpdater</RootNamespace>
    <AssemblyName>JFToolkit.WordToCUpdater</AssemblyName>
    
    <!-- NuGet metadata -->
    <PackageId>JFToolkit.WordToCUpdater</PackageId>
    <Version>0.1.0</Version>
    <Authors>Harald Daltveit</Authors>
    <Description>
      Zero-dependency COM interop wrapper for updating Word Table of Contents
      with correct page numbers. Works with Word 2007 through Office 365.
      Late-bound — no compile-time coupling to any specific Word version.
    </Description>
    <PackageTags>word;toc;table-of-contents;com-interop;office;document-automation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
